export TF_VAR_do_token=
export AWS_ACCESS_KEY_ID=
export SPACES_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export SPACES_SECRET_ACCESS_KEY=
export SIGNOZ_ENDPOINT=
export SIGNOZ_INGESTION_KEY=

# RunPod
export RUNPOD_API_KEY=            # required — runpodctl reads this from the env (no `runpodctl doctor` needed)
export LLM_VOLUME_ID=            # required for up/destroy — set after `./llm.py create-volume`
# Optional — llm.py has defaults / auto-detects; uncomment only to override:
#export LLM_GPU="NVIDIA A40"          # 48GB 70B-Q4 card; `./llm.py datacenters` shows live stock
#export LLM_DATACENTER=               # auto-picked from in-stock DCs for LLM_GPU if left unset
#export LLM_MODEL="hermes3:70b"
#export LLM_VOLUME_SIZE="80"
